# Sixora server configuration (/etc/sixora/sixora.env)
SIXORA_PORT=8080
SIXORA_HOST=0.0.0.0
SIXORA_DATA_DIR=/var/lib/sixora
# open = anyone may register, invite = with an invite code from an
# administrator, closed = nobody. The very first account (the administrator)
# can always be created.
SIXORA_REGISTRATION=invite
# Name shown in the apps:
#SIXORA_SERVER_NAME=Sixora
# Behind a reverse proxy (Nginx Proxy Manager): take the client address from
# X-Forwarded-For. Only if port 8080 is reachable from the proxy alone!
#SIXORA_TRUST_PROXY=true
# Own TLS instead of a reverse proxy (readable by the sixora user):
#SIXORA_TLS_CERT=/etc/sixora/fullchain.pem
#SIXORA_TLS_KEY=/etc/sixora/privkey.pem
TZ=Europe/Berlin
